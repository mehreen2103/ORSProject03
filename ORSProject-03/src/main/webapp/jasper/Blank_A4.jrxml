	<queryString language="SQL">
		<![CDATA[select id, name, roll_no, physics,chemistry, maths,(physics + chemistry + maths) as total from st_marksheet where physics >= 33 and chemistry >= 33 and maths >= 33 order by total desc limit 0, 10]]>
